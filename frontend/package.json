    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
